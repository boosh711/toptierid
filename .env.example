# PostgreSQL (local docker-compose uses port 5433)
DATABASE_URL="postgresql://toptier:toptier@localhost:5433/toptierid"

# Neon: use pooled URL for app, direct URL for migrations (optional locally)
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session signing (min 32 chars in production)
SESSION_SECRET="dev-secret-change-in-production-min-32-chars"

# App URL for calendar feeds
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Vercel Blob for video/photo uploads in production
