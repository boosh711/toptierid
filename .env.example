# PostgreSQL (local docker-compose uses port 5433)
DATABASE_URL="postgresql://toptier:toptier@localhost:5433/toptierid"

# Vercel + Neon Storage may auto-set these instead of DATABASE_URL (app supports both):
# POSTGRES_PRISMA_URL="postgresql://..."
# POSTGRES_URL="postgresql://..."

# Or paste Neon pooled URL as DATABASE_URL in Vercel:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Session signing (min 32 chars in production)
SESSION_SECRET="dev-secret-change-in-production-min-32-chars"

# App URL for calendar feeds
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Vercel Blob for video/photo uploads in production
# BLOB_READ_WRITE_TOKEN=""
